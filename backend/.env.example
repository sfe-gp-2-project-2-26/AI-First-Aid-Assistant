# --- App Configuration ---
APP_NAME="First Aid RAG API"
DEBUG=false

# --- Gemini LLM ---
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Embedding & PDF Chunking Service (Remote Colab / GPU behind ngrok) ---
# "remote" delegates /embed and /chunk_pdf to your Colab notebook URL
EMBEDDING_PROVIDER_TYPE=remote
EMBEDDING_URL=https://your-colab-tunnel.ngrok-free.app
EMBEDDING_TIMEOUT=120
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# --- Document Parser (Docling) ---
DOCLING_PROVIDER_TYPE=remote
DOCLING_DO_OCR=false

# --- Vector DB (Qdrant) ---
# Local Docker or hosted instance
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=clinical_documents

# --- Retrieval Parameters ---
MIN_SIMILARITY_SCORE_THRESHOLD=80
HYBRID_TOP_K=15
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60

# --- Speech-to-Text (Groq Whisper Cloud API) ---
# Get your API key from https://console.groq.com/keys
STT_PROVIDER_TYPE=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
STT_TIMEOUT=120
