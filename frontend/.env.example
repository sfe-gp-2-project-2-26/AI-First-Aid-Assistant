# Phone number dialed by the mobile-only "Call Ambulance" button
VITE_AMBULANCE_NUMBER=+201154768115

# Optional: direct browser-to-backend URL for /transcribe.
# Leave empty to use the built-in same-origin proxy (/api/backend/*) which
# forwards to BACKEND_URL — no CORS setup needed.
VITE_API_BASE_URL=

# Server-side default upstream for /api/backend/* (defaults to http://localhost:3000)
BACKEND_URL=http://localhost:3000
